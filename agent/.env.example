# ── LLM (Groq — free tier, no credit card required) ──────────────────────────
# Sign up at https://console.groq.com → API Keys → Create key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (SMTP — no OAuth, no API key required) ──────────────────────────────
# Gmail: enable 2-Step Verification → Security → App Passwords → generate key
# Outlook / any SMTP relay: use your normal credentials
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional SMTP overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Daily sending limit (default 25)
# DAILY_EMAIL_LIMIT=25
